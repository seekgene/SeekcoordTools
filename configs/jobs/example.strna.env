# Example per-job config for SeekcoordTools_run.sh CONFIG mode.
# Copy this file per sample/job and edit the values below.

export SEEKCOORD_RUN_WORKFLOW="FF"

export SEEKCOORD_SAMPLE_NAME="test"
export SEEKCOORD_CHIP_NUMBER="ST110250_A1"
export SEEKCOORD_CASNO="prod_case"
export SEEKCOORD_CHEMISTRY="BBV2.4"
export SEEKCOORD_SPECIES="Mus_musculus"
export SEEKCOORD_METHOD="gene_expr"
export SEEKCOORD_MODE="strna"

export SEEKCOORD_THREAD="32"
export SEEKCOORD_BIN="50"
export SEEKCOORD_PIXEL_SIZE="0.5"

# Optional per-job path overrides. Prefer keeping machine/account paths in
# configs/seekcoord.env unless a specific job needs a different directory.
# export SEEKCOORD_FASTQ_DIR="/mnt/strna/seekcoord/fastq/BBV2.4"
# export SEEKCOORD_FASTQ_NAME="ST110250_A1"
# export SEEKCOORD_MASK_DIR="/mnt/strna/seekcoord/ST_mask"
# export SEEKCOORD_IMAGE_DIR="/mnt/strna/seekcoord/images"
# export SEEKCOORD_REFERENCE_DIR="/mnt/strna/seekcoord/reference"

# Common production switches.
export SEEKCOORD_RESUME_EXISTING="0"
export SEEKCOORD_GENE_MASK_FILTER="0"
export SEEKCOORD_ENABLE_CAVITY_FILTER="0"
export SEEKCOORD_ENABLE_STARDIST_CELL_SEGMENT="0"

# Extra args are optional. Use a bash array when values may contain spaces.
# SEEKCOORD_EXTRA_ARGS=(--cavity-mask-preset adipose)
