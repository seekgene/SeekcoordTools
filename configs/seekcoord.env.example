# SeekcoordTools v1.8 portable configuration template.
#
# Copy one of these:
#   cp configs/seekcoord.env.example configs/seekcoord.env
#   cp configs/seekcoord.env.example seekcoord.local.env
#
# Or point to any file:
#   export SEEKCOORD_CONFIG=/path/to/seekcoord.env
#
# Shell syntax is used, so quote paths that contain spaces.

# Main data workspace. Input/output subdirectories default under this root.
export SEEKCOORD_WORKSPACE="${HOME}/seekcoord"

# Data layout. Override only what differs from the default workspace layout.
export SEEKCOORD_REFERENCE_DIR="${SEEKCOORD_WORKSPACE}/reference"
export SEEKCOORD_FFPE_REFERENCE_DIR="${SEEKCOORD_REFERENCE_DIR}/Homo_sapiens_wtpanel"
export SEEKCOORD_MASK_DIR="${SEEKCOORD_WORKSPACE}/ST_mask"
export SEEKCOORD_IMAGE_DIR="${SEEKCOORD_WORKSPACE}/images"
export SEEKCOORD_FASTQ_ROOT="${SEEKCOORD_WORKSPACE}/fastq"
export SEEKCOORD_RESULTS_ROOT="${SEEKCOORD_WORKSPACE}/results"
export SEEKCOORD_SRC_DIR="${SEEKCOORD_WORKSPACE}/src"
export SEEKCOORD_BINSEGMENT_ROOT="${SEEKCOORD_WORKSPACE}/binSegment"

# Spatial runtime inputs are staged under each result directory:
#   <result>/<case>/<sample>/06.segment/mask
# Put manual masks there as manual_mask.png and he_manual_mask.png.

# On FASTQ changes or supplementary sequencing reruns, stale sequencing-derived
# outputs are removed by default. Set to 1 only when old outputs must be kept.
# export SEEKCOORD_RERUN_ARCHIVE=1

# Unified runtime environment.
export SEEKCOORD_ENV_NAME="seekcoord18"
# Optional. Usually auto-detected from an active conda install or $HOME/miniforge3.
# export SEEKCOORD_CONDA_ROOT="${HOME}/miniforge3"
# export SEEKCOORD_ENV_PREFIX="${SEEKCOORD_CONDA_ROOT}/envs/${SEEKCOORD_ENV_NAME}"

# Set to 1 if scripts should activate SEEKCOORD_ENV_NAME automatically.
export SEEKCOORD_AUTO_ACTIVATE=0

# Set to 1 if command lookup should prefer the unified environment bin directory.
export SEEKCOORD_USE_ENV_PATH=0

# Optional FFPE/probe STAR multi-mapping cap. Leave unset to use script defaults
# (10 for FFPE spatial/probe mode, 1 for scrna).
# export SEEKCOORD_STAR_MULTIMAP=10

# Optional local StarDist model cache. If unset, StarDist can use its own cache.
# export SEEKCOORD_STARDIST_MODEL_DIR="${HOME}/.keras/models/StarDist2D/2D_versatile_he/2D_versatile_he_extracted"

# Optional report generator overrides. Normally the scripts use package-local tools.
# export SEEKCOORD_SPATIAL_REPORT_GENERATOR="/path/to/spatial_report_generator.py"
# export SEEKCOORD_SCRNA_REPORT_GENERATOR="/path/to/scrna_report_generator.py"

# Production integration:
# PMSystem or another scheduler should point SEEKCOORD_CONFIG to this file and
# call `SeekcoordTools_run.sh CONFIG <job.env>`. Keep account-specific paths here,
# and keep sample-specific parameters in each job.env file.
